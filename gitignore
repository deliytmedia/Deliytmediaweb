# ── API Keys & Secrets ───────────────────────────────────────
# NEVER commit these to GitHub
.env
.env.local
.env.development
.env.production
.env.staging
*.env
secrets.js
secrets.json
config.local.js


# ── Apps Script Config (if exported locally) ─────────────────
# Your real API keys live inside agent-backend.gs
# Make sure you replace keys with placeholders before pushing
# agent-backend.gs     ← uncomment this line to block the file entirely
#                         or just ensure keys say YOUR_KEY_HERE before push


